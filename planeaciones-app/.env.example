# Base de datos persistente para los endpoints de proyectos y planeaciones.
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Opcional: habilita Gemini. Sin esta clave se usan las plantillas locales.
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite

# Opcional: necesario para guardar archivos PDF/DOCX en Vercel Blob.
BLOB_READ_WRITE_TOKEN=

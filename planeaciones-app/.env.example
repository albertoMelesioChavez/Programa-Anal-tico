# En desarrollo, vacías para usar SQLite local. En producción, configura Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: habilita Gemini. Sin esta clave se usan las plantillas locales.
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite

# Opcional: necesario para guardar archivos PDF/DOCX en Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# OAuth de Google. La URI de redirección debe terminar en /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# En producción el acceso de prueba está apagado, salvo que se habilite explícitamente.
DEMO_USER_ENABLED=false
DEMO_USER_EMAIL=demo@gestion-aula.local
